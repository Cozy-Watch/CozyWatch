# Only required for an official signed and notarized macOS release.
COZYWATCH_OFFICIAL_BUILD=false
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Optional when more than one signing identity is installed.
APPLE_SIGNING_IDENTITY=

# Public Lemon Squeezy product ID, not an API key. Required for official lifetime releases.
COZYWATCH_LIFETIME_PRODUCT_ID=

# Development/test builds only. Uses separate development storage. Never enable on production releases.
COZYWATCH_LICENSE_TEST_MODE=false
